# Local demo configuration. Browser users register individual accounts.
# Keep any optional internal operator token and Neatlogs key outside source control.
SENTINEL_DB_PATH=backend/sentinel.db
SENTINEL_PROJECT_ROOT=backend/project_data
SENTINEL_SOURCE_ROOT=verification/lab
SENTINEL_PROTECTED_TESTS_ROOT=verification/protected_tests
SENTINEL_FRONTEND_ORIGIN=http://localhost:5173
SENTINEL_OPERATOR_NAME=local-operator
SENTINEL_OPERATOR_TOKEN=
# Real local planner and Docker verifier adapters.
SENTINEL_AGENT_CALLABLE=agent.planner:propose_patch
SENTINEL_VERIFIER_CALLABLE=verification.adapter:verify_backend_patch
SENTINEL_MAX_REQUEST_BYTES=16384
SENTINEL_PLANNER_TIMEOUT_SECONDS=300
SENTINEL_INFERENCE_TIMEOUT=280
SENTINEL_MAX_TOKENS=350
SENTINEL_PROVIDER_RETRIES=0
SENTINEL_VERIFIER_TIMEOUT_SECONDS=300
# Demo mode is local only. Production mode intentionally refuses startup until
# an external OIDC identity provider and isolated verifier are integrated.
SENTINEL_ENV=demo
SENTINEL_LEASE_SECONDS=30
